{
  "rules": {
    ".read": false,
    ".write": false,
    "DHTPulse": {
      ".read": "auth != null",
      "device_01": {
        "latest": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['temperature', 'humidity', 'timestamp', 'status'])",
          "temperature": {
            ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 80"
          },
          "humidity": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() == 'online' || newData.val() == 'offline')"
          },
          "$other": {
            ".validate": false
          }
        },
        "history": {
          ".read": "auth != null",
          "$timestamp": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['temperature', 'humidity', 'timestamp'])",
            "temperature": {
              ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 80"
            },
            "humidity": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
